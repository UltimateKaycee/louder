<%- include('partials/header'); -%>
<h1>Composer</h1>
<form class="" action="/composepg" method="post">
    <div class="form-group mb-3">
        <label>Post Title</label>
        <input class="form-control input-border" type="text" name="post_title">
    </div>
    <div class="form-group mb-3">
        <label>Post Message</label>
        <textarea class="form-control input-border" name="post_message" cols="40" rows="5"></textarea>
    </div>
    <button type="submit" name="button" class="btn btn-primary">Publish Message</button>
</form>


<%- include('partials/footer'); -%>